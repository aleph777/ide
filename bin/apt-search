use Modern::Perl;

use constant _ME_ => $0 =~ m=([^/]+)$=;

my @s = grep !/^\s*$/,qx(apt search $ARGV[0] 2>>/dev/null);

my $rx = defined $ARGV[1] ? $ARGV[1] : $ARGV[0];

say $_ for map { (split '/')[0] } grep m=$rx/=o,@s;
