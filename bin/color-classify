use Modern::Perl;
use File::IO;
use Util::Color;

use constant _ME_ => $0 =~ m=([^/]+)$=;

use constant _RATIO_ => 1.95;

my $io = File::IO->new(chomp => 1, newline => 1);

$io->get(path => $ARGV[0]);

for (grep /^.defconst/,@{$io->contents})
{
  s/\).+/\)/;

  my ($rgb) = /"(#.+)"/;

   my $color = Util::Color->new(value => $rgb);

  my $ct = $color->getColorType();

  s/$/ ;; $ct->{SHADE} $ct->{TYPE}/;

  my ($hue,$saturation,$luminosity) = $color->computeHSL();

 s/gray$/join '','gray (',$color->getHslInfo($hue,$saturation,$luminosity),')'/e;

  my $cb = $color->computeContrast(hex1 => $rgb,hex2 => "#000000");
  my $cw = $color->computeContrast(hex1 => $rgb,hex2 => "#ffffff");

  s/$/join ' ',', text:',$cb > _RATIO_*$cw ? 'black' : 'white'/e;

}
$io->put(path => $ARGV[0]);
