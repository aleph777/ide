# Purpose:   installs modules from CPAN that are are needed for IDE
#
# Arguments: n/a
#
# Revision:
#
use strict;
use v5.10;

use constant _ME_   => $0 =~ m=([^/]+)$=;
use constant _CPAN_ => 'cpanm';

sub installModule
{
  my $module  = shift;
  my $command = join ' ',_CPAN_,'install',$module;

  system $command;

  die _ME_,": could not install $module!!!" if $? != 0;
}

my @modules1 = qw(CPAN
                  YAML);

my @modules2 = qw(Archive::Tar
                  Digest::SHA
                  File::HTTP
                  File::Which
                  IO::Compress::Xz
                  IO::Uncompress::UnXz
                  List::MoreUtils
                  Log::Log4perl
                  Modern::Perl
                  Math::Random::Secure
                  Perl::Critic
                  Perl::MinimumVersion
                  Regexp::Assemble
                  Scalar::Util
                  Text::Balanced);

# system join '',_CPAN_," install $_"   for @modules1;
# system join '',_CPAN_,' reload CPAN';
# system join '',_CPAN_," install $_"   for @modules2;
installModule($_) for @modules1;

system join ' ',_CPAN_,'reload CPAN';

installModule($_) for @modules2;
#                  MP3::Mplib
#                  Perl::LanguageServer
