use Modern::Perl;

use constant _ME_ => $0 =~ m=([^/]+)$=;

my $url = shift;

# my ($tag) = map { substr((split '/', $_)[-1],0,-1) } qx(git ls-remote --tags --sort=version:refname "$url" | grep -v '\^' | tail -1);
my ($tag) = map { substr((split '/', $_)[-1],0,-1) } qx(git ls-remote --tags --sort=version:refname "$url" | grep -v '\\^' | tail -1);

say $tag;
