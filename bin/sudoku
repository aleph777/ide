#!/usr/bin/env -S perl -w   # -*-Perl-*-

use Modern::Perl;
use Math::Random::Secure;
use integer;

use constant _ME_ => $0 =~ m=([^/]+)$=;

# dimensions
#
use constant SIZE_BASIC => 3;
use constant SQUARES    => SIZE_BASIC**2;
use constant ROWS       => SQUARES;
use constant COLUMNS    => SQUARES;
use constant NUMBERS    => (1 .. SIZE_BASIC**2);

# total number of numbers in the puzzle
#
use constant NUMBERS_TOTAL => ROWS * COLUMNS;

# total number of numbers that are randomly initialized
#
use constant NUMBERS_INITIALIZED => SQUARES*3;

# total number of numbers shown to player
#   this number can be altered depending on puzzle difficulty
#
use constant NUMBERS_SHOWN => SIZE_BASIC**3;

# total number of numbers to solve
#
use constant NUMBERS_SOLVED => NUMBERS_TOTAL - NUMBERS_INITIALIZED;

# total number of numbers hidden from player
#
use constant NUMBERS_HIDDEN => NUMBERS_TOTAL - NUMBERS_SHOWN;

# board display elements
#
use constant EM_DASH    => '—';
use constant WIDTH      => 2*SIZE_BASIC + 1;
use constant HORIZONTAL => EM_DASH x WIDTH;
use constant LINE       => join '+',(HORIZONTAL) x SIZE_BASIC;

use constant BOLD   => "\e[1m";
use constant NORMAL => "\e[0m";

# map of row, column to square numbers
#  e.g.
#  1 | 2 | 3
#  ——+———+——
#  4 | 5 | 6
#  ——+———+——
#  7 | 8 | 9
#
my %sqmap = (1 => {1 => 1,2 => 1,3 => 1,4 => 2, 5 => 2,6 => 2,7 => 3,8 => 3,9 => 3},
             2 => {1 => 1,2 => 1,3 => 1,4 => 2, 5 => 2,6 => 2,7 => 3,8 => 3,9 => 3},
             3 => {1 => 1,2 => 1,3 => 1,4 => 2, 5 => 2,6 => 2,7 => 3,8 => 3,9 => 3},
             4 => {1 => 4,2 => 4,3 => 4,4 => 5, 5 => 5,6 => 5,7 => 6,8 => 6,9 => 6},
             5 => {1 => 4,2 => 4,3 => 4,4 => 5, 5 => 5,6 => 5,7 => 6,8 => 6,9 => 6},
             6 => {1 => 4,2 => 4,3 => 4,4 => 5, 5 => 5,6 => 5,7 => 6,8 => 6,9 => 6},
             7 => {1 => 7,2 => 7,3 => 7,4 => 8, 5 => 8,6 => 8,7 => 9,8 => 9,9 => 9},
             8 => {1 => 7,2 => 7,3 => 7,4 => 8, 5 => 8,6 => 8,7 => 9,8 => 9,9 => 9},
             9 => {1 => 7,2 => 7,3 => 7,4 => 8, 5 => 8,6 => 8,7 => 9,8 => 9,9 => 9},
            );

my @avkeys;

my %board;     # the sudoku board
my %row;       # row availability flags
my %col;       # column availability flags
my %sq;        # square availability flags
my %available; # per open row and column contains list of available numbers


sub init
{
  foreach my $x (NUMBERS) { foreach my $y (NUMBERS) { push @avkeys,join ',',$x,$y; } }

  %board = map { $_ => { map { $_ => 0 } (1 .. COLUMNS) } } 1 .. ROWS;
  %row   = map { $_ => { map { $_ => 1 } (1 .. COLUMNS) } } 1 .. ROWS;
  %col   = map { $_ => { map { $_ => 1 } (1 .. COLUMNS) } } 1 .. ROWS;
  %sq    = map { $_ => { map { $_ => 1 } (1 .. COLUMNS) } } 1 .. ROWS;

  %available = map { $_ => [] } @avkeys;

  for (my $i = 1; $i <= ROWS-SIZE_BASIC+1; $i += SIZE_BASIC) {
    initPuzzle($i .. $i+SIZE_BASIC-1);
  }
}


sub bold
{
  return join '',BOLD,shift,NORMAL;
}


# display a SIZE_BASIC x SIZE_BASIC data structure
#
sub display
{
  my $r = shift;

  foreach my $row (1 .. ROWS)
  {
    for (my $c = 0; $c < COLUMNS-SIZE_BASIC; $c += SIZE_BASIC) {
      print ' ',join ' ',(map { bold($r->{$row}{$c+$_}) } 1 .. SIZE_BASIC),'|';
    }
    say ' ',join ' ',map { bold($r->{$row}{$_}) } COLUMNS-SIZE_BASIC+1 .. COLUMNS;

    say LINE if $row != ROWS && ($row % SIZE_BASIC == 0);
  }
}


# fill a square randomly
#
sub initPuzzle
{
  my @rows = @_;
  my @cols = @_;

  my @pool = NUMBERS;

  foreach my $row (@rows)
  {
    foreach my $col (@cols)
    {
      my $num = splice(@pool,rand(@pool),1);

      $board{$row}{$col} = $num;

      $row{$row}{$num} = $col{$col}{$num} = $sq{$sqmap{$row}{$col}}{$num} = 0;

      delete $available{"$row,$col"};
    }
  }
}


# make list of available numbers for each open location
#
sub determineAvailable
{
  foreach my $key (grep { exists $available{$_} } @avkeys)
  {
    my ($r,$c) = split ',',$key;

    @{$available{$key}} = grep { $row{$r}{$_} && $col{$c}{$_} && $sq{$sqmap{$r}{$c}}{$_} } NUMBERS;
  }
}


# put a number in an open location
#
sub placeNumber
{
  determineAvailable();

  my ($key) = sort { @{$available{$a}} <=> @{$available{$b}} } keys %available;

  return 0 if @{$available{$key}} == 0;

  my $num = $available{$key}[rand(@{$available{$key}})];

  my ($row,$col) = split ',',$key;

  $board{$row}{$col} = $num;

  $row{$row}{$num} = $col{$col}{$num} = $sq{$sqmap{$row}{$col}}{$num} = 0;

  delete $available{$key};

  return 1;
}


# form puzzle by hiding numbers
#
sub hideNumbers
{
  my $n = shift;

  my @pool = @avkeys;

  for (1 .. $n)
  {
    my $key = splice(@pool,rand(@pool),1);

    my ($row,$col) = split ',',$key;

    $board{$row}{$col} = '_';
  }
}


init();

for (my $i = 1; $i <= NUMBERS_SOLVED; ++$i)
{
  unless (placeNumber())
  {
    say STDERR '========== RETRY ==========';

    $i = 0;

    init();
  }
}
display(\%board);

say EM_DASH x 24;

hideNumbers(NUMBERS_HIDDEN);
display(\%board);
