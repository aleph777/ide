# Purpose:   installs modules from CPAN that are are needed for IDE
#
# Arguments: n/a
#
use strict;
use v5.10;

use constant _ME_ => $0 =~ m=([^/]+)$=;

sub findNumberedPackage
{
  my ($pkg,$rx) = split ':',shift;

  my @pkgs = map { (split '/',$_)[0] } grep m=^$rx=,qx(apt search $pkg 2>>/dev/null);

  return (sort { rev($a) <=> rev($b) } @pkgs)[-1];
}

sub verifyPackage
{
  my $package = shift;

  my ($vp) = grep m=^$package/=,qx(apt search $package 2>>/dev/null);

  if (!defined $vp)
  {
    say _ME_,": $package was not found!!!";

    return ();
  }
  return $package;
}

sub installPackage
{
  my $package = shift;

  system "apt install -y $package";

  die _ME_,": $package was not installed!" if $? != 0;
}

sub rev
{
  return ($_[0] =~ /(\d+)/)[0];
}

my @numbered = qw(clang:^clang-\d+/
                  clang-format:^clang-format-\d+
                  clang-tidy:^clang-tidy-\d+
                  clang-tools:^clang-tools-\d+
                  clangd:^clangd-\d+
                  gcc:^gcc-\d+/
                  libgccjit:^libgccjit-\d+-dev
                  libgnutls:^libgnutls\d+-dev
);

my @packages = qw(autoconf
                  build-essential
                  cargo
                  cpanminus
                  cppcheck
                  curl
                  ffmpeg
                  flex
                  fonts-inter
                  indent
                  jupyter
                  klatexformula
                  libffi-dev
                  libgdbm-dev
                  libgif-dev
                  libgpm-dev
                  libgtk-3-dev
                  libio-aio-perl
                  libjansson-dev
                  libjpeg-dev
                  liblcms2-dev
                  libncurses-dev
                  libotf-dev
                  libpng-dev
                  libreadline-dev
                  librsvg2-dev
                  libssl-dev
                  libsystemd-dev
                  libtiff5-dev
                  libtree-sitter-dev
                  libxml2-dev
                  libxpm-dev
                  libyaml-dev
                  net-tools
                  p7zip-full
                  python3-dev
                  rustc
                  sdcv
                  sloccount
                  texinfo
                  texlive-latex-base
                  yasm
                  zlib1g-dev
                );

my @install = sort { $a cmp $b } (map { verifyPackage($_) } @packages), map { findNumberedPackage($_) } @numbered;

system "apt update";
installPackage($_) for @install;
system "cargon install perl-lsp";
