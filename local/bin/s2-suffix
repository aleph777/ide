#!/usr/bin/env -S perl   # -*-Perl-*-

use Modern::Perl;
use File::Basename;

use constant _ME_ => $0 =~ m=([^/]+)$=;

my $rx_suffix = qr/\.[^.\/]+$/;

sub filter
{
  my $files = shift;

  return grep /$rx_suffix/o,@{$files};
}

sub get_suffix
{
  return (fileparse(basename(shift),qr/$rx_suffix/o))[2];
}

my @dir = grep { -d } @ARGV ? @ARGV : '.';

my @cmd;

push @cmd,'pfind -no-dir -no-bin -no-zero-size';
push @cmd,"-no-name '(?:[Dd]ebugger|doc|(?:ex|s)amples|opensource|[Ss]im|[Tt]est|yocto)'";
push @cmd,"-no-suffix '([[:digit:]]+|[Bb]ak|bnf|bodies|d|diagram|hex|o|t?bin)'";

my $cmd = join ' ',@cmd;

my @files = qx($cmd @dir);

chomp @files;

@files = filter(\@files);

my %suffix = map { get_suffix($_) => 1 } @files;

my %sftype;

foreach my $suffix (sort keys %suffix)
{
  my @files = qx(find @dir -name '*$suffix');

  chomp @files;

  foreach my $file (@files)
  {
    my ($ftype)         = qx(file -i "$file");
    my ($xxx,$charset) = split ': ',$ftype;

    chomp $charset;

    die "$file: ($ftype)" unless defined $ftype;

    $sftype{$suffix}{$charset} = 1 unless exists $sftype{$suffix}{$charset};
  }
}
foreach  my $suffix (sort keys %sftype)
{
  say sprintf('%-22s | %s',$suffix,$_ ) for sort keys %{$sftype{$suffix}};
}