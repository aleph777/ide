#!/usr/bin/env -S perl   # -*-Perl-*-

use Modern::Perl;
use File::IO;

use constant _UFW_ => "$ENV{HOME}/code/Core/netbox/os_root/etc/ufw/applications.d/s2netbox.ufw.profile";

my $ip1 = '192.168.56.64';  # NetBox 6.4
my $ip2 = '192.168.56.66';  # NetBox 6.6

my $rx_digit5     = qr/[1-9]\d{0,4}/;
my $rx_port_range = qr/($rx_digit5):($rx_digit5)\/(tcp|udp)/o;
my $rx_port_list  = qr/$rx_digit5(?:,$rx_digit5)*/o;

my $io = File::IO->new(chomp => 1);

$io->get(path => _UFW_);

my @ports_raw = map { /$rx_port_range/o ? join(',',($1 .. $2))."/$3" : $_ } grep /^ports/,@{$io->contents};
my @ports_tcp = map { /($rx_port_list)\/tcp/o } grep /\d{1,5}\/tcp/,@ports_raw;
my @ports_udp = map { /($rx_port_list)\/udp/o } grep /\d{1,5}\/udp/,@ports_raw;

my $tcp = join ',',@ports_tcp;
my $udp = join ',',@ports_udp;

system "nmap -sT -top-ports 20 $ip1";
system "nmap -sT -p$tcp $ip1";
system "sudo nmap -sU -sV -p$udp $ip1";
system "sudo nmap -sU -sV -top-ports 100 $ip1";
say '--------------------------------------------------------------------------------';
system "nmap -sT -top-ports 20 $ip2";
system "nmap -sT -p$tcp $ip2";
system "sudo nmap -sU -sV -p$udp $ip2";
system "sudo nmap -sU -sV -top-ports 100 $ip2";
