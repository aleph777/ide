use Modern::Perl;

use constant _ME_ => $0 =~ m=([^/]+)$=;

my ($symbol,$lib) = @ARGV;

$lib = '/usr/lib/x86_64-linux-gnu' unless defined $lib;

my @files = qx(find $lib -type f -name "*.so*" 2>>/dev/null);

chomp @files;

my %x;

foreach my $file (@files)
{
  # nm -D --defined-only 2>/dev/null | c++filt | grep
  my @nm = qx(nm -D --defined-only $file 2>>/dev/null | c++filt);

  for (@nm)
  {
    say "$file: $_" for /($symbol)/g;
  }
}